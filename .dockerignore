# Target directory (build artifacts)
target/
**/target/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
*.md
README*
docs/

# Development files
.env
.env.local
.env.development
.env.test

# Logs
*.log
logs/

# Nix files (not needed in container)
flake.nix
flake.lock

# Test files
**/tests/
**/*_test.rs
**/*_tests.rs

# Backup files
*.bak
*.backup

# Temporary files
tmp/
temp/

# Docker files (avoid recursive copying)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD files
.github/
.gitlab-ci.yml
Jenkinsfile

# Cache directories
.cache/
node_modules/