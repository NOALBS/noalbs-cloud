msgstr "用法：{prefix}bbb <{min}-{max} kbps>"

msgid "Usage: {prefix}bbt <interface, e.g. usb0>"
msgstr "用法：{prefix}bbt <網路介面，例如 usb0>"

msgid "Usage: {prefix}mbitrate <kbps of a preset>"
msgstr "用法：{prefix}mbitrate <預設組合的 kbps>"

