# Reworded and completed for NOALBS Cloud with AI help, not yet checked by a native speaker.
msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh-tw\n"

msgid "scene: {scene}"
msgstr "場景：{scene}"

msgid "scene: unknown"
msgstr "場景：未知"

msgid "bitrate: {bitrate} kbps"
