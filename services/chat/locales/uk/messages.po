msgstr "Офлайн-бітрейт має бути нижчим за бітрейт LOW"

msgid "The offline RTT must be higher than the LOW RTT"
msgstr "Офлайн-RTT має бути вищим за RTT LOW"

msgid "Usage: {prefix}switch <scene name>"
msgstr "Використання: {prefix}switch <назва сцени>"

msgid "Usage: {prefix}source <source name>"
msgstr "Використання: {prefix}source <назва джерела>"

msgid "Usage: {prefix}bbb <{min}-{max} kbps>"
msgstr "Використання: {prefix}bbb <{min}-{max} kbps>"

msgid "Usage: {prefix}bbt <interface, e.g. usb0>"
msgstr "Використання: {prefix}bbt <інтерфейс, напр. usb0>"

msgid "Usage: {prefix}mbitrate <kbps of a preset>"
msgstr "Використання: {prefix}mbitrate <kbps пресету>"

msgid "Usage: {prefix}{command} [on|off]"
msgstr "Використання: {prefix}{command} [on|off]"

msgid "Usage: {prefix}{command} <kbps|off>"
msgstr "Використання: {prefix}{command} <kbps|off>"

msgid "Usage: {prefix}{command} <ms|off>"
msgstr "Використання: {prefix}{command} <ms|off>"

msgid "Usage: {prefix}alias <alias> <command> | {prefix}alias rem <alias>"
msgstr "Використання: {prefix}alias <псевдонім> <команда> | {prefix}alias rem <псевдонім>"

msgid "Usage: {prefix}noalbs version | prefix <new> | lang <code>"
msgstr "Використання: {prefix}noalbs version | prefix <новий> | lang <код>"

msgid "Still connecting to BELABOX Cloud. Try again in a moment."
msgstr "Ще підключаюся до BELABOX Cloud. Спробуй ще раз за мить."

msgid "BELABOX Cloud refused the secret URL. Check it in the switcher's settings."
msgstr "BELABOX Cloud відхилив секретний URL. Перевір його в налаштуваннях світчера."

msgid "The BELABOX is offline."
msgstr "BELABOX офлайн."

msgid "The BELABOX has no stream settings yet. Start it once from its own page."
msgstr "У BELABOX ще немає налаштувань стріму. Запусти його один раз із його власної сторінки."

msgid "The BELABOX is already streaming."
msgstr "BELABOX уже в ефірі."

msgid "The BELABOX isn't streaming."
msgstr "BELABOX не в ефірі."

msgid "The bitrate must be between 300 and 12000 kbps."
msgstr "Бітрейт має бути від 300 до 12 000 kbps."

msgid "The BELABOX has no such network interface."
msgstr "У BELABOX немає такого мережевого інтерфейсу."

msgid "The last network interface can't be turned off."
msgstr "Останній мережевий інтерфейс не можна вимкнути."

msgid "The BELABOX can't do that."
msgstr "BELABOX цього не вміє."

msgid "{name}: off"
msgstr "{name}: вимкнено"

msgid "no network interfaces"
msgstr "немає мережевих інтерфейсів"

