msgid "Switched to the Ending scene"
msgstr "Перемкнуто на сцену «Кінець»"

msgid "Switched to the Refresh scene"
msgstr "Перемкнуто на сцену «Оновлення»"

msgid "Chat notifications on"
msgstr "Сповіщення в чаті увімкнено"

msgid "Chat notifications off"
msgstr "Сповіщення в чаті вимкнено"

