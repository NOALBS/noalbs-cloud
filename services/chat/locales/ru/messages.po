# Russian for the NOALBS Cloud chat bot.
# Builds on the NOALBS translations by UnisonRU, blackVanilla and Murr.
# Reworded and completed for NOALBS Cloud with AI help, not yet checked by a native speaker.
msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ru\n"

msgid "scene: {scene}"
msgstr "сцена: {scene}"

msgid "scene: unknown"
msgstr "сцена: неизвестно"

msgid "bitrate: {bitrate} kbps"
msgstr "битрейт: {bitrate} kbps"

msgid "bitrate: unknown"
msgstr "битрейт: неизвестно"

msgid "not streaming"
msgstr "не в эфире"

msgid "fps: {fps}"
msgstr "FPS: {fps}"

