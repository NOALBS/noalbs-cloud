msgstr "сеть: {dropped}"

msgid "rendering lag: {dropped}"
msgstr "задержка рендера: {dropped}"

msgid "encoding lag: {dropped}"
msgstr "задержка кодирования: {dropped}"

msgid "dropped due to: {causes}"
msgstr "пропуск кадров: {causes}"

