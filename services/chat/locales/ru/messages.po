msgstr "Триггеры RTT должны быть от 1 до 60 000 ms"

msgid "The offline bitrate must be lower than the LOW bitrate"
msgstr "Офлайн-битрейт должен быть ниже битрейта LOW"

msgid "The offline RTT must be higher than the LOW RTT"
msgstr "Офлайн-RTT должен быть выше RTT для LOW"

msgid "Usage: {prefix}switch <scene name>"
msgstr "Использование: {prefix}switch <название сцены>"

msgid "Usage: {prefix}source <source name>"
msgstr "Использование: {prefix}source <название источника>"

msgid "Usage: {prefix}bbb <{min}-{max} kbps>"
msgstr "Использование: {prefix}bbb <{min}-{max} kbps>"

msgid "Usage: {prefix}bbt <interface, e.g. usb0>"
msgstr "Использование: {prefix}bbt <интерфейс, напр. usb0>"

msgid "Usage: {prefix}mbitrate <kbps of a preset>"
msgstr "Использование: {prefix}mbitrate <kbps пресета>"

msgid "Usage: {prefix}{command} [on|off]"
msgstr "Использование: {prefix}{command} [on|off]"

msgid "Usage: {prefix}{command} <kbps|off>"
msgstr "Использование: {prefix}{command} <kbps|off>"

msgid "Usage: {prefix}{command} <ms|off>"
msgstr "Использование: {prefix}{command} <ms|off>"

msgid "Usage: {prefix}alias <alias> <command> | {prefix}alias rem <alias>"
msgstr "Использование: {prefix}alias <псевдоним> <команда> | {prefix}alias rem <псевдоним>"

msgid "Usage: {prefix}noalbs version | prefix <new> | lang <code>"
msgstr "Использование: {prefix}noalbs version | prefix <новый> | lang <код>"

msgid "Still connecting to BELABOX Cloud. Try again in a moment."
msgstr "Всё ещё подключаюсь к BELABOX Cloud. Попробуй ещё раз чуть позже."

msgid "BELABOX Cloud refused the secret URL. Check it in the switcher's settings."
msgstr "BELABOX Cloud отклонил секретный URL. Проверь его в настройках свитчера."

msgid "The BELABOX is offline."
msgstr "BELABOX не в сети."

msgid "The BELABOX has no stream settings yet. Start it once from its own page."
msgstr "У BELABOX пока нет настроек стрима. Запусти его один раз с его собственной страницы."

msgid "The BELABOX is already streaming."
msgstr "BELABOX уже в эфире."

msgid "The BELABOX isn't streaming."
msgstr "BELABOX не в эфире."

msgid "The bitrate must be between 300 and 12000 kbps."
msgstr "Битрейт должен быть от 300 до 12 000 kbps."

msgid "The BELABOX has no such network interface."
msgstr "У BELABOX нет такого сетевого интерфейса."

msgid "The last network interface can't be turned off."
msgstr "Нельзя отключить последний сетевой интерфейс."

msgid "The BELABOX can't do that."
msgstr "BELABOX так не умеет."

msgid "{name}: off"
msgstr "{name}: выкл."

msgid "no network interfaces"
msgstr "нет сетевых интерфейсов"

