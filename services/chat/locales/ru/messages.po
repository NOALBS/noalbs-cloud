msgstr "память: {memory} МБ"

msgid "free disk space: {disk} GB"
msgstr "свободно на диске: {disk} ГБ"

msgid "No LIVE scene is picked yet. Choose one on the Scenes page."
msgstr "Сцена LIVE ещё не выбрана. Выбери её на странице «Сцены»."

msgid "No Privacy scene is picked yet. Choose one on the Scenes page."
msgstr "Сцена «Приватность» ещё не выбрана. Выбери её на странице «Сцены»."

msgid "No Starting scene is picked yet. Choose one on the Scenes page."
msgstr "Сцена «Начало» ещё не выбрана. Выбери её на странице «Сцены»."

msgid "No Ending scene is picked yet. Choose one on the Scenes page."
msgstr "Сцена «Конец» ещё не выбрана. Выбери её на странице «Сцены»."

msgid "No Refresh scene is picked yet. Choose one on the Scenes page."
msgstr "Сцена «Обновление» ещё не выбрана. Выбери её на странице «Сцены»."

msgid "Switched to the LIVE scene"
msgstr "Сцена переключена на LIVE"

msgid "Switched to the Privacy scene"
msgstr "Сцена переключена на «Приватность»"

msgid "Switched to the Starting scene"
msgstr "Сцена переключена на «Начало»"

msgid "Switched to the Ending scene"
msgstr "Сцена переключена на «Конец»"

msgid "Switched to the Refresh scene"
msgstr "Сцена переключена на «Обновление»"

msgid "Chat notifications on"
msgstr "Уведомления в чате: вкл."

msgid "Chat notifications off"
msgstr "Уведомления в чате: выкл."

msgid "Auto stop on raid on"
msgstr "Автостоп при рейде: вкл."

msgid "Auto stop on raid off"
msgstr "Автостоп при рейде: выкл."

msgid "Public commands on"
msgstr "Публичные команды: вкл."

msgid "Public commands off"
msgstr "Публичные команды: выкл."

msgid "Mod commands on"
msgstr "Команды модераторов: вкл."

msgid "Mod commands off"
msgstr "Команды модераторов: выкл."

