msgstr "Alias {alias} fjernet"

msgid "{alias} is already taken"
msgstr "{alias} brukes allerede som alias"

msgid "There's no alias {alias}"
msgstr "Alias {alias} eksisterer ikke"

msgid "There's no command {command}"
msgstr "Kommandoen {command} eksisterer ikke"

msgid "Commands now start with {prefix}"
msgstr "Kommandoer starter nå med {prefix}"

msgid "Language set to {language}"
msgstr "Språk satt til {language}"

