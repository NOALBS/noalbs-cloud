msgstr "Bitrate-utløsere må være mellom 1 og 100 000 kbps"

msgid "RTT triggers must be between 1 and 60,000 ms"
msgstr "RTT-utløsere må være mellom 1 og 60 000 ms"

msgid "The offline bitrate must be lower than the LOW bitrate"
msgstr "Offline-bitraten må være lavere enn LOW-bitraten"

msgid "The offline RTT must be higher than the LOW RTT"
msgstr "Offline-RTT må være høyere enn LOW-RTT"

msgid "Usage: {prefix}switch <scene name>"
msgstr "Bruk: {prefix}switch <scenenavn>"

msgid "Usage: {prefix}source <source name>"
msgstr "Bruk: {prefix}source <kildenavn>"

msgid "Usage: {prefix}bbb <{min}-{max} kbps>"
msgstr "Bruk: {prefix}bbb <{min}-{max} kbps>"

msgid "Usage: {prefix}bbt <interface, e.g. usb0>"
msgstr "Bruk: {prefix}bbt <grensesnitt, f.eks. usb0>"

msgid "Usage: {prefix}mbitrate <kbps of a preset>"
msgstr "Bruk: {prefix}mbitrate <kbps for en forhåndsinnstilling>"

msgid "Usage: {prefix}{command} [on|off]"
msgstr "Bruk: {prefix}{command} [on|off]"

msgid "Usage: {prefix}{command} <kbps|off>"
msgstr "Bruk: {prefix}{command} <kbps|off>"

msgid "Usage: {prefix}{command} <ms|off>"
msgstr "Bruk: {prefix}{command} <ms|off>"

msgid "Usage: {prefix}alias <alias> <command> | {prefix}alias rem <alias>"
msgstr "Bruk: {prefix}alias <alias> <kommando> | {prefix}alias rem <alias>"

msgid "Usage: {prefix}noalbs version | prefix <new> | lang <code>"
msgstr "Bruk: {prefix}noalbs version | prefix <ny> | lang <kode>"

msgid "Still connecting to BELABOX Cloud. Try again in a moment."
msgstr "Kobler fortsatt til BELABOX Cloud. Prøv igjen om litt."

msgid "BELABOX Cloud refused the secret URL. Check it in the switcher's settings."
msgstr "BELABOX Cloud avviste den hemmelige URL-en. Sjekk den i innstillingene for switcheren."

msgid "The BELABOX is offline."
msgstr "BELABOX-en er offline."

msgid "The BELABOX has no stream settings yet. Start it once from its own page."
msgstr "BELABOX-en har ingen strøminnstillinger ennå. Start den én gang fra siden dens."

msgid "The BELABOX is already streaming."
msgstr "BELABOX-en strømmer allerede."

msgid "The BELABOX isn't streaming."
msgstr "BELABOX-en strømmer ikke."

msgid "The bitrate must be between 300 and 12000 kbps."
msgstr "Bitraten må være mellom 300 og 12 000 kbps."

msgid "The BELABOX has no such network interface."
msgstr "BELABOX-en har ikke et slikt nettverksgrensesnitt."

msgid "The last network interface can't be turned off."
msgstr "Det siste nettverksgrensesnittet kan ikke slås av."

msgid "The BELABOX can't do that."
msgstr "BELABOX-en kan ikke gjøre det."

msgid "{name}: off"
msgstr "{name}: av"

msgid "no network interfaces"
msgstr "ingen nettverksgrensesnitt"

msgid "streaming, max {bitrate} kbps"
msgstr "strømmer, maks {bitrate} kbps"

msgid "streaming"
msgstr "strømmer"

msgid "BELABOX ({state}): {interfaces} | Total: {total} kbps"
msgstr "BELABOX ({state}): {interfaces} | Totalt: {total} kbps"

msgid "OBS isn't connected right now."
msgstr "OBS er ikke tilkoblet akkurat nå."

msgid "OBS said no: {reason}"
msgstr "OBS sa nei: {reason}"

msgid "OBS said no: code {code}"
msgstr "OBS sa nei: kode {code}"

msgid "OBS didn't answer. Try again in a moment."
msgstr "OBS svarte ikke. Prøv igjen om litt."

msgid "Something went wrong. Try again in a moment."
msgstr "Noe gikk galt. Prøv igjen om litt."

msgid "No scene matches \"{query}\"."
msgstr "Ingen scene samsvarer med \"{query}\"."

msgid "Switched to {scene}"
msgstr "Byttet til {scene}"

