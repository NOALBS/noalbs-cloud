msgstr "{command} er ikke tilgjengelig i NOALBS Cloud ennå."

msgid "Switched to {scene} · {server} at {reading}"
msgstr "Byttet til {scene} · {server} med {reading}"

msgid "Switched to {scene} · {server}"
