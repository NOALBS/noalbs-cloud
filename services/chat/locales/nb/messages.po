msgstr "minne: {memory} MB"

msgid "free disk space: {disk} GB"
msgstr "ledig diskplass: {disk} GB"

msgid "No LIVE scene is picked yet. Choose one on the Scenes page."
msgstr "Ingen LIVE-scene er valgt ennå. Velg en på Scener-siden."

msgid "No Privacy scene is picked yet. Choose one on the Scenes page."
msgstr "Ingen Privat-scene er valgt ennå. Velg en på Scener-siden."

msgid "No Starting scene is picked yet. Choose one on the Scenes page."
msgstr "Ingen Start-scene er valgt ennå. Velg en på Scener-siden."

msgid "No Ending scene is picked yet. Choose one on the Scenes page."
msgstr "Ingen Slutt-scene er valgt ennå. Velg en på Scener-siden."

msgid "No Refresh scene is picked yet. Choose one on the Scenes page."
msgstr "Ingen Oppdater-scene er valgt ennå. Velg en på Scener-siden."

msgid "Switched to the LIVE scene"
msgstr "Byttet til LIVE-scenen"

msgid "Switched to the Privacy scene"
msgstr "Byttet til Privat-scenen"

msgid "Switched to the Starting scene"
msgstr "Byttet til Start-scenen"

msgid "Switched to the Ending scene"
msgstr "Byttet til Slutt-scenen"

msgid "Switched to the Refresh scene"
msgstr "Byttet til Oppdater-scenen"

msgid "Chat notifications on"
msgstr "Chatvarsler er aktivert"

msgid "Chat notifications off"
msgstr "Chatvarsler er deaktivert"

msgid "Auto stop on raid on"
msgstr "Automatisk stopp ved raid er aktivert"

msgid "Auto stop on raid off"
msgstr "Automatisk stopp ved raid er deaktivert"

msgid "Public commands on"
msgstr "Offentlige kommandoer er aktivert"

msgid "Public commands off"
msgstr "Offentlige kommandoer er deaktivert"

msgid "Mod commands on"
msgstr "Mod-kommandoer er aktivert"

msgid "Mod commands off"
msgstr "Mod-kommandoer er deaktivert"

