msgstr "SRT-inngang"

msgid "RTMP ingest - {stream}"
msgstr "RTMP-inngang - {stream}"

msgid "scene: {scene}"
msgstr "scene: {scene}"

msgid "scene: unknown"
msgstr "scene: ukjent"

msgid "bitrate: {bitrate} kbps"
msgstr "bitrate: {bitrate} kbps"

msgid "bitrate: unknown"
msgstr "bitrate: ukjent"

msgid "not streaming"
msgstr "strømmer ikke"

