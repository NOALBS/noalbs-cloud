# Copy to .env and fill in. Generate each secret with: openssl rand -hex 32

# Where people open NOALBS Cloud (no trailing slash).
NOALBS_PUBLIC_URL=https://noalbs.example.com

# ":80" when your own proxy handles TLS; your domain (noalbs.example.com) to let
# the dashboard container get certificates itself (ports 80 and 443 open).
SITE_ADDRESS=:80
# The header holding the visitor's IP, for rate limits. The dashboard container sets
# x-forwarded-for, but behind your own proxy that's the proxy's address: use the header
# it sets instead (Cloudflare: cf-connecting-ip), and don't let anyone reach port 80 around it.
#CLIENT_IP_HEADER=x-forwarded-for

POSTGRES_PASSWORD=
# Signs the login cookie.
COOKIE_SECRET=
# Encrypts stored passwords (OBS, stream servers). Keep it: changing it makes them unreadable.
DATA_ENCRYPTION_KEY=

# OAuth apps. Leave a pair empty to hide that sign-in option.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# YouTube (a Google Cloud OAuth client with the YouTube Data API v3 on; see README).
# The API key is only for looking channels up by handle (ignored chatters).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Billing with Stripe (see README, "Billing"). Leave the key empty to turn billing off;
# staff can still set plans by hand. Products and prices are set up in Admin → Products.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Images: ghcr.io/<owner>/noalbs-cloud/<service>:<tag>
#NOALBS_IMAGE_PREFIX=ghcr.io/noalbs/noalbs-cloud
#NOALBS_TAG=latest

# Local testing only:
#DEV_LOGIN=true
#ALLOW_PRIVATE_STATS_URLS=true
#HTTP_PORT=8080

# Observability (see README, "Observability"): logs, traces and metrics over OTLP/HTTP.
# Empty endpoint = logs to stdout only. Grafana Cloud: the stack's OTLP endpoint and
# "Authorization=Basic <base64 of instance-id:token>" (URL-encode the space as %20).
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
# Which logs go out (RUST_LOG syntax, default info), and json for JSON lines on stdout.
#LOG_EXPORT_FILTER=info
#LOG_FORMAT=json
